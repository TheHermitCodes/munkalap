# Copy to supabase/functions/.env for local development.
# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically.

# Where invite links point.
SITE_URL=http://localhost:3000

# Optional. Without it, send-invite logs the link and the app shows it to copy.
RESEND_API_KEY=
INVITE_FROM_EMAIL="Munkalap <onboarding@resend.dev>"
