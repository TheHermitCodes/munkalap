# Copy to .env.local. Values come from `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (sb_publishable_...) or the legacy anon key. Safe to expose:
# it only identifies the project; Row Level Security does the protecting.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
